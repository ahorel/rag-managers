# MatchConsult — Variables d'environnement serveur
# Copier en .env à la racine du projet et remplir les valeurs
# NE PAS commiter ce fichier dans git

# ── LLM : Groq (gratuit) ─────────────────────────────────────
# Créer une clé sur https://console.groq.com
GROQ_API_KEY=gsk_votre_cle_groq

# ── Qdrant (géré par Docker — ne pas modifier) ───────────────
QDRANT_URL=http://qdrant:6333

# ── Configuration générale ────────────────────────────────────
GROQ_MODEL=llama-3.1-8b-instant
DEMO_MODE=false
CV_DIRECTORY=./data/cvs

# ── CORS : URL de votre frontend ─────────────────────────────
# En production : mettre l'IP ou le domaine du serveur
CORS_ORIGINS=http://IP_SERVEUR
